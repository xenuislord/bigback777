{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --use-system-ca --import tsx apps/server/src/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "desktop": "electron apps/desktop/main.cjs",
    "package:mac": "npm run build && npm run build:server && electron-builder --mac --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:server": "tsup && node scripts/package-server.mjs",
    "test:runtime": "npm run build:server && node scripts/runtime-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.90.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "local.hearth.household",
    "productName": "HEARTH",
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/**",
      "dist/**",
      "dist-server/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "apps/desktop/main.cjs"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.food-and-drink"
    }
  }
}
